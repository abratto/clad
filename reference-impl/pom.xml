<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>com.example.clad</groupId>
  <artifactId>clad-reference-impl</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>clad-reference-impl</name>
  <description>CLAD reference implementations (Java/Micronaut profiles) reactor.</description>

  <modules>
    <module>clad-engine</module>
    <module>legible-engine</module>
    <module>java-legible</module>
    <module>legible-storage</module>
    <module>java-micronaut-jena</module>
    <module>java-micronaut-postgres</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.source>21</maven.compiler.source>
    <maven.compiler.target>21</maven.compiler.target>
    <micronaut.version>4.10.16</micronaut.version>
    <micronaut.core.version>4.10.25</micronaut.core.version>
    <micronaut.maven.plugin.version>4.7.2</micronaut.maven.plugin.version>
    <micronaut.test.resources.version>4.0.0</micronaut.test.resources.version>
    <micronaut.openapi.version>6.20.0</micronaut.openapi.version>
    <jena.version>5.2.0</jena.version>
    <junit.version>5.11.0</junit.version>
    <archunit.version>1.3.0</archunit.version>
    <graphql-java.version>22.4</graphql-java.version>
    <testcontainers.version>1.20.4</testcontainers.version>
    <jooq.version>3.19.10</jooq.version>
    <flyway.version>10.17.2</flyway.version>
    <!-- Pin Jetty to 12.0.x — Micronaut BOM manages to 12.1.x but
         Fuseki 5.2.0 requires 12.0.x (MimeTypes$Wrapper removed in 12.1) -->
    <jetty.version>12.0.14</jetty.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>io.micronaut.platform</groupId>
        <artifactId>micronaut-platform</artifactId>
        <version>${micronaut.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
</project>
