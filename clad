#!/usr/bin/env bash
# CLAD CLI — lightweight wrapper for quality-gate scripts.
# Auto-discovers the active feature so you never type a feature path.
#
# Usage:
#   ./clad advance       — run advance.py for the active feature
#   ./clad approve 1     — approve gate 1 for the active feature
#   ./clad approve-iter <name> — approve iterative change
#   ./clad approve-maintenance <name> <design|evidence> — approve maintenance gate
#   ./clad promote-concepts — promote approved proposals into the concept corpus
#   ./clad verify        — run verify_artefacts.py
#   ./clad next          — show what stage comes next
#   ./clad stages        — show all stages and their status
#   ./clad checklists    — show task checklists for the current stage
#   ./clad feature       — show the active feature
#   ./clad help          — show this help
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
# Use PWD for finding features/projects (so ./clad works from any
# CLAD-derived project root), use SCRIPT_DIR for finding quality-gate/
# scripts (which ship with clad itself).
PROJECT_ROOT="${PWD}"
# If the current directory has features/, use that. Otherwise use SCRIPT_DIR.
if [ -d "$PROJECT_ROOT/features" ]; then
    FEATURES_DIR="$PROJECT_ROOT/features"
    QG="$PROJECT_ROOT/quality-gate"
else
    FEATURES_DIR="$SCRIPT_DIR/features"
    QG="$SCRIPT_DIR/quality-gate"
fi

resume_mtime() {
    stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null || echo 0
}

active_feature() {
    # An explicit override always wins: a multi-feature repo can be ambiguous,
    # and a gate approval must never target a guessed feature.
    if [ -n "${CLAD_FEATURE:-}" ]; then
        if [ ! -d "$FEATURES_DIR/$CLAD_FEATURE" ]; then
            echo "CLAD_FEATURE='$CLAD_FEATURE' is not a feature under $FEATURES_DIR" >&2
            exit 1
        fi
        echo "$CLAD_FEATURE"
        return 0
    fi

    # Only features that are actually in progress are candidates. A feature
    # whose RESUME is TBD or feature-complete must never outrank a live one —
    # a completed worked example carrying uncommitted _changes/ is not itself
    # in progress.
    local d b resume stage m
    local only_change="" n_change=0
    local n_progress=0 best_progress="" best_progress_m=0 progress_ties=0
    local progress_list=""

    for d in "$FEATURES_DIR"/UC-*/; do
        [ -d "$d" ] || continue
        b=$(basename "$d")
        resume="$d/RESUME.md"
        [ -f "$resume" ] || continue
        stage=$(grep -m1 'Current stage' "$resume" 2>/dev/null | sed 's/.*`\(.*\)`.*/\1/')
        [ -n "$stage" ] || continue
        case "$stage" in
            TBD|None*|*"feature complete"*) continue;;
        esac
        n_progress=$((n_progress + 1))
        progress_list="${progress_list}  ${b}
"
        m=$(resume_mtime "$resume")
        if [ "${m:-0}" -gt "${best_progress_m:-0}" ]; then
            best_progress_m="${m:-0}"; best_progress="$b"; progress_ties=1
        elif [ "${m:-0}" -eq "${best_progress_m:-0}" ]; then
            progress_ties=$((progress_ties + 1))
        fi
        # Uncommitted _changes/ mark a live iterative change; more than one is
        # ambiguous, so refuse rather than guess the gate target.
        if [ -d "$d/_changes" ] && [ -n "$(git -C "$PROJECT_ROOT" status --porcelain -- "$d/_changes" 2>/dev/null \
                   | grep -E '\.md$' | grep -v '\.gitkeep' || true)" ]; then
            n_change=$((n_change + 1))
            [ -z "$only_change" ] && only_change="$b"
        fi
    done

    if [ "$n_change" -gt 1 ]; then
        echo "Ambiguous active feature: several in-progress features have uncommitted _changes/:" >&2
        printf '%s' "$progress_list" >&2
        echo "Re-run with CLAD_FEATURE=<name>, or pass the feature explicitly." >&2
        exit 1
    fi
    if [ "$n_change" -eq 1 ]; then
        echo "$only_change"
        return 0
    fi

    if [ "$n_progress" -gt 1 ] && [ "$progress_ties" -gt 1 ]; then
        echo "Ambiguous active feature: several are in progress with equally recent RESUME.md:" >&2
        printf '%s' "$progress_list" >&2
        echo "Re-run with CLAD_FEATURE=<name>, or pass the feature explicitly." >&2
        exit 1
    fi
    if [ "$n_progress" -ge 1 ] && [ -n "$best_progress" ]; then
        echo "$best_progress"
        return 0
    fi

    # Fallback: the most recently modified feature that is not complete (covers
    # a freshly created, not-yet-started feature whose Current stage is TBD).
    local best2="" best2_m=0
    for d in "$FEATURES_DIR"/UC-*/; do
        [ -d "$d" ] || continue
        resume="$d/RESUME.md"
        [ -f "$resume" ] || continue
        if grep -qi 'feature complete' "$resume" 2>/dev/null; then continue; fi
        m=$(resume_mtime "$resume")
        if [ "${m:-0}" -gt "${best2_m:-0}" ]; then
            best2_m="$m"; best2="$(basename "$d")"
        fi
    done
    if [ -n "$best2" ]; then echo "$best2"; return 0; fi
    # Fallback: first feature with a RESUME.md
    for d in "$FEATURES_DIR"/UC-*/; do
        [ -d "$d" ] || continue
        [ -f "$d/RESUME.md" ] || continue
        basename "$d"
        return 0
    done
    echo "" >&2
    return 1
}

cmd_advance() {
    local feat="${1:-$(active_feature)}"
    [ -z "$feat" ] && { echo "No active feature found."; exit 1; }
    shift || true
    python3 "$QG/advance.py" --feature "features/$feat" "$@"
}

cmd_approve() {
    local gate="${1:-}"
    [ -z "$gate" ] && { echo "Usage: ./clad approve <gate-number>"; exit 1; }
    local feat
    feat=$(active_feature)
    python3 "$QG/approve_gate.py" --feature "features/$feat" --gate "$gate"
}

cmd_approve_iter() {
    local name="${1:-}"
    [ -z "$name" ] && { echo "Usage: ./clad approve-iter <change-name>"; exit 1; }
    local feat
    feat=$(active_feature)
    python3 "$QG/approve_gate.py" --feature "features/$feat" --iterative "$name"
}

cmd_approve_maintenance() {
    local name="${1:-}"
    local gate="${2:-}"
    if [ -z "$name" ] || [ -z "$gate" ]; then
        echo "Usage: ./clad approve-maintenance <name> <design|evidence>"
        exit 1
    fi
    python3 "$QG/approve_maintenance_change.py" --change "maintenance/$name.md" --gate "$gate"
}

cmd_promote_concepts() {
    # Promotion WRITES the canonical corpus, so it must never guess: the active-
    # feature heuristic is for read commands. Running it for a superseded feature
    # overwrites newer corpus content with that feature's older proposal.
    local feat="${1:-${CLAD_FEATURE:-}}"
    if [ -z "$feat" ]; then
        echo "promote-concepts needs an explicit feature: ./clad promote-concepts <name>" >&2
        echo "  (or set CLAD_FEATURE=<name>). It writes the corpus, so it will not guess." >&2
        exit 1
    fi
    shift || true
    python3 "$QG/promote_concepts.py" --feature "features/$feat" "$@"
}

cmd_verify() {
    python3 "$QG/verify_artefacts.py" "$@"
}

cmd_next() {
    local feat
    feat=$(active_feature)
    [ -z "$feat" ] && { echo "No active feature found."; exit 1; }
    local resume="$FEATURES_DIR/$feat/RESUME.md"
    echo "Feature: $feat"
    grep -E '(Current stage|Next stage|Next file|Gate [123]|Last completed)' "$resume" 2>/dev/null | sed 's/^/  /'
}

cmd_stages() {
    local feat="${1:-$(active_feature)}"
    [ -z "$feat" ] && { echo "No active feature found."; exit 1; }
    # Handle both basename and features/XX path forms
    local feat_path="$FEATURES_DIR/$feat"
    [ -d "$feat_path" ] || feat_path="$feat"
    echo "Feature: $(basename "$feat_path")"
    echo ""
    python3 -c "
import sys; sys.path.insert(0, '$QG')
import clad_stages as cs
feat_root = '$feat_path'
for s in cs.STAGES:
    d = s.output_dir(feat_root)
    populated = '✓' if cs.dir_is_populated(d) else '·'
    gate = f' [Gate {s.gate_after}]' if s.gate_after else ''
    print(f'  {populated} Stage {s.id} {s.label:24s}{gate}')
"
}

cmd_checklists() {
    local feat
    feat=$(active_feature)
    [ -z "$feat" ] && { echo "No active feature found."; exit 1; }
    local resume="$FEATURES_DIR/$feat/RESUME.md"
    local current
    current=$(grep 'Current stage' "$resume" 2>/dev/null | head -1 | sed 's/.*`\(.*\)`.*/\1/')
    [ -z "$current" ] && { echo "Could not determine current stage."; exit 1; }
    
    # Map stage label back to context path
    python3 -c "
import sys; sys.path.insert(0, '$QG')
import clad_stages as cs
for s in cs.STAGES:
    if f'Stage {s.id} — {s.label}' == '$current':
        path = s.context_path('$FEATURES_DIR/$feat')
        import os
        if os.path.isfile(path):
            with open(path) as f:
                for line in f:
                    if line.startswith('- [ ]') or line.startswith('- [x]'):
                        print(line.rstrip())
        break
"
}

cmd_feature() {
    local feat
    feat=$(active_feature)
    [ -z "$feat" ] && echo "No active feature." || echo "$feat"
}

cmd_help() {
    cat << 'HELP'
CLAD CLI — lightweight wrapper for quality-gate scripts.

  ./clad advance [<feature>]      Run advance.py (auto-discovers if omitted)
  ./clad approve <1|2|3>           Approve a human gate
  ./clad approve-iter <name>       Approve an iterative change
    ./clad approve-maintenance <name> <design|evidence>
                                                                        Approve a maintenance change gate
  ./clad promote-concepts <feature>  Promote approved NEW/EXTEND concept
                                       proposals into the canonical corpus
                                       (after Gate 2 approval)
  ./clad verify                    Run verify_artefacts.py (artefact gate)
  ./clad next                      Show current stage and next steps
  ./clad stages [<feature>]        Show all stages and completion status
  ./clad checklists                Show task checklists for the current stage
  ./clad feature                   Show the active feature name
  ./clad help                      Show this help

All commands auto-discover the active feature from RESUME.md.
No need to type feature paths — but only a feature that is actually
in progress is a candidate, and when discovery is ambiguous (several
in-progress features carry uncommitted _changes/) the command stops
instead of guessing:

  CLAD_FEATURE=UC-02-catalogue-title ./clad approve 2

Use CLAD_FEATURE (or the explicit <feature> argument where a command
takes one) whenever more than one feature is in flight.
HELP
}

# Route to subcommand
case "${1:-help}" in
    advance)     shift; cmd_advance "$@";;
    approve)     shift; cmd_approve "$@";;
    approve-iter) shift; cmd_approve_iter "$@";;
    approve-maintenance) shift; cmd_approve_maintenance "$@";;
    promote-concepts) shift; cmd_promote_concepts "$@";;
    verify)      shift; cmd_verify "$@";;
    next)        cmd_next;;
    stages)      cmd_stages "${2:-}";;
    checklists)  cmd_checklists;;
    feature)     cmd_feature;;
    help|--help|-h) cmd_help;;
    *)           echo "Unknown command: ${1:-}"; echo "Try: ./clad help"; exit 1;;
esac
